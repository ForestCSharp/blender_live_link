// blender_live_link.fbs
// Flatbuffers IDL file for blender live link
 
namespace Blender.LiveLink;

struct Vec2
{
	x : float;
	y : float;
}

struct Vec3 
{
  x	: float;
  y	: float;
  z	: float;
}

struct Vec4 
{
  x	: float;
  y	: float;
  z	: float;
  w	: float;
}

struct Quat 
{
  x	: float;
  y	: float;
  z	: float;
  w	: float;
}

table Matrix
{
	elements : [float];
}

table Mesh
{
	// Basic Geometric Data
	positions		: [float];	// 3 components per vert (X,Y,Z)
	normals			: [float];	// 3 components per vert (X,Y,Z)
	texcoords		: [float];	// 2 components per vert (U,V)

	// Index Buffer
	indices			: [uint];	// 1 index per vert

	// Optional Skinning Data
	joint_indices	: [int];	// 4 joint indices per vert
	joint_weights	: [float];	// 4 joint weights per vert

	// Material Data
	material_ids	: [int];	

	// Armature this mesh is bound to
	armature_id		: int = -1;
	mesh_to_armature : Matrix;
	armature_to_mesh : Matrix;
}

table Bone
{
	name				: string;
	parent_name			: string;
	parent_index		: int = -1;
	inverse_bind_matrix	: Matrix;
}

table Animation
{
	name				: string;
	frame_rate			: float;
	duration_seconds	: float;
	frame_count			: int;
	bone_count			: int;
	skin_matrices		: [float]; // frame-major, bone-major, column-major 4x4 armature-space matrices
}

table Armature
{
	bones		: [Bone];
	animations	: [Animation];
}

struct RigidBody
{
	// Does this rigid body actively participate in the simulation?
	is_dynamic	: bool;

	// Mass in kg
	mass		: float;

	//TODO: Shape Enum or Shape Union
}

enum LightType : byte
{ 
	Point	= 0,
	Spot	= 1,
	Sun		= 2, 
	Area 	= 3,
}

enum PartType : byte
{
	Body		= 0,
	Legs		= 1,
	LeftArm		= 2,
	RightArm	= 3,
	Head		= 4,
}

enum AttachmentBindingType : byte
{
	Object	= 0,
	Bone	= 1,
}

struct PointLight
{
	// power in watts
	power : float;
}

struct SpotLight
{
	// power in watts
	power		: float;

	// Beam Angle in Radians 
	beam_angle	: float;

	// Softness of Spotlight Edge (0.0 - 1.0)
	edge_blend	: float;
}

struct SunLight
{
	// Runtime incident irradiance before atmospheric attenuation, in W/m^2.
	// Blender exporters convert authoring Sun strength by multiplying by 1361.
	power			: float;

	// does this sunlight cast shadows?
	cast_shadows	: bool;
}

//TODO: AreaLight

table Light 
{
	type		: LightType;
	color 		: Vec3;
	use_shadow 	: bool;

	point_light	: PointLight;
	spot_light  : SpotLight;
	sun_light 	: SunLight;
}

table GameplayComponentCharacter
{
	player_controlled	: bool;
	move_speed			: float;
	jump_speed			: float;
}

table GameplayComponentCameraControl
{
	follow_distance 	: float;
	follow_speed		: float;
}

table GameplayComponentFogController
{
	enabled				: bool = true;
	density				: float = 0.015;
	base_height			: float = 0.0;
	scale_height		: float = 25.0;
	max_distance		: float = 500.0;
	ceiling_enabled		: bool = false;
	ceiling_height		: float = 100.0;
	ceiling_fade		: float = 25.0;
	fog_color			: Vec3;
	ambient_intensity	: float = 0.4;
	sun_intensity		: float = 1.0;
	anisotropy			: float = 0.2;
}

table GameplayComponentSkyAtmosphere
{
	enabled						: bool = true;
	planet_center_z_m				: float = -6360000.0;
	air_density					: float = 1.0;
	aerosol_density				: float = 1.0;
	ozone_density					: float = 1.0;
	ground_albedo					: Vec3;
	sky_intensity					: float = 1.0;
	sun_disc_angular_diameter_degrees	: float = 0.5357;
	sun_disc_intensity			: float = 1.0;
	atmosphere_height_m			: float = 60000.0;
	rayleigh_scale_height_m		: float = 8000.0;
	mie_scale_height_m			: float = 1200.0;
	mie_anisotropy				: float = 0.8;
	max_sun_zenith_angle_degrees	: float = 102.0;
}

enum CloudLayerProfile : byte
{
	Stratus		= 0,
	Cumulus		= 1,
	Cumulonimbus	= 2,
	Cirrus			= 3,
}

table CloudLayer
{
	enabled					: bool = true;
	profile					: CloudLayerProfile = Cumulus;
	seed_offset				: uint = 0;
	base_altitude_m			: float = 1800.0;
	thickness_m				: float = 3000.0;
	coverage					: float = 0.5;
	density					: float = 1.0;
	shape_scale_m				: float = 8000.0;
	detail_scale_m			: float = 1000.0;
	erosion					: float = 0.65;
	anvil_bias					: float = 0.1;
	wind_multiplier			: float = 1.0;
	phase_forward				: float = 0.75;
	phase_backward			: float = -0.25;
	phase_blend				: float = 0.8;
	ambient_scale				: float = 0.6;
	multi_scattering_strength	: float = 0.8;
}

table GameplayComponentCloudSystem
{
	enabled				: bool = true;
	seed				: uint = 1;
	weather_world_scale_m	: float = 100000.0;
	wind_direction		: Vec2;
	wind_speed_m_s		: float = 20.0;
	shadow_enabled		: bool = true;
	shadow_extent_m		: float = 8000.0;
	layers				: [CloudLayer];
}

table GameplayComponentPart
{
	part_type : PartType = Body;
}

table GameplayComponentAttachmentPoint
{
	owner_part_id	: int = -1;
	part_type		: PartType = Legs;
	binding_type	: AttachmentBindingType = Object;
	armature_id		: int = -1;
	bone_name		: string;
	local_transform	: Matrix;
	valid			: bool = false;
}

// TODO: Other Gameplay Components

union GameplayComponent
{
	GameplayComponentCharacter,
	GameplayComponentCameraControl,
	GameplayComponentFogController,
	GameplayComponentPart,
	GameplayComponentAttachmentPoint,
	GameplayComponentSkyAtmosphere,
	GameplayComponentCloudSystem
}

table GameplayComponentContainer
{
	value : GameplayComponent;
}

table Object 
{
	name		: string;
	unique_id	: int;
	visibility	: bool;

	// transform information
	location	: Vec3;
	scale		: Vec3;
	rotation	: Quat;

	// optional mesh data
	mesh		: Mesh;

	// optional armature data
	armature 	: Armature;

	// optional rigid body data
	rigid_body  : RigidBody;

	// optional light data
	light 		: Light;

	// array of gameplay components
	components	: [GameplayComponentContainer];
}

table Material
{
	unique_id				: int;
	name					: string;

	base_color				: Vec4;
	base_color_image_id		: int; 

	metallic				: float;
	metallic_image_id		: int;

	roughness				: float;
	roughness_image_id		: int;

	emission_color			: Vec4;
	emission_color_image_id	: int;
	emission_strength		: float;
}

table Image
{
	unique_id	: int;
	width		: int;
	height		: int;
	data		: [ubyte];
}

table EditorCamera
{
	location	: Vec3;
	forward		: Vec3;
	up			: Vec3;
}

table Update 
{
	objects				: [Object];
	deleted_object_uids : [int];
	materials			: [Material];
	images				: [Image];
	reset 				: bool = false;
	generation_seconds	: double = 0.0;
	editor_camera		: EditorCamera;
}

root_type Update;
