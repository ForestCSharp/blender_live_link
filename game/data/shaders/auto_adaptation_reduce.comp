#version 450

#include "auto_adaptation.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer HistogramBuffer
{
	HistogramBin bins[AUTO_ADAPTATION_HISTOGRAM_BIN_COUNT];
};

layout(std430, set = 0, binding = 1) writeonly buffer MeasurementBuffer
{
	vec4 exposure_white;
	vec4 target_log_lms;
	vec4 solar_diagnostics;
} measurement;

layout(push_constant) uniform PushConstants
{
	float auto_exposure_min_ev;
	float auto_exposure_max_ev;
} pc;

const float VIRTUAL_D65_Y = 0.01;
const vec2 D65_XY = vec2(0.3127, 0.3290);
const vec3 D65_XYZ = vec3(0.95047, 1.0, 1.08883);
const mat3 BRADFORD = mat3(
	vec3( 0.8951, -0.7502,  0.0389),
	vec3( 0.2664,  1.7135, -0.0685),
	vec3(-0.1614,  0.0367,  1.0296));

void main()
{
	uint total_count = 0u;
	for (uint bin = 0u; bin < AUTO_ADAPTATION_HISTOGRAM_BIN_COUNT; ++bin)
		total_count += bins[bin].count;
	if (total_count == 0u)
	{
		measurement.exposure_white = vec4(0.0, D65_XY, 0.0);
		measurement.target_log_lms = vec4(0.0);
		measurement.solar_diagnostics = vec4(0.0);
		return;
	}

	uint low_remaining = uint(floor(float(total_count) * 0.02));
	uint high_remaining = total_count - uint(ceil(float(total_count) * 0.98));
	uint accepted[AUTO_ADAPTATION_HISTOGRAM_BIN_COUNT];
	for (uint bin = 0u; bin < AUTO_ADAPTATION_HISTOGRAM_BIN_COUNT; ++bin)
	{
		uint removed = min(low_remaining, bins[bin].count);
		accepted[bin] = bins[bin].count - removed;
		low_remaining -= removed;
	}
	for (int bin = int(AUTO_ADAPTATION_HISTOGRAM_BIN_COUNT) - 1; bin >= 0; --bin)
	{
		uint removed = min(high_remaining, accepted[bin]);
		accepted[bin] -= removed;
		high_remaining -= removed;
	}

	float weighted_ev = 0.0;
	float weighted_x = 0.0;
	float weighted_y = 0.0;
	float luminance_weight = 0.0;
	uint accepted_count = 0u;
	for (uint bin = 0u; bin < AUTO_ADAPTATION_HISTOGRAM_BIN_COUNT; ++bin)
	{
		if (accepted[bin] == 0u || bins[bin].count == 0u) continue;
		float ev = AUTO_ADAPTATION_MIN_EV + float(bin)
			* (AUTO_ADAPTATION_MAX_EV - AUTO_ADAPTATION_MIN_EV)
			/ float(AUTO_ADAPTATION_HISTOGRAM_BIN_COUNT);
		float count = float(accepted[bin]);
		accepted_count += accepted[bin];
		weighted_ev += ev * count;
		float weight = AUTO_ADAPTATION_MIDDLE_GRAY * exp2(ev) * count;
		float average_x = float(bins[bin].sum_x)
			/ (float(bins[bin].count) * AUTO_ADAPTATION_FIXED_SCALE);
		float average_y = float(bins[bin].sum_y)
			/ (float(bins[bin].count) * AUTO_ADAPTATION_FIXED_SCALE);
		weighted_x += average_x * weight;
		weighted_y += average_y * weight;
		luminance_weight += weight;
	}
	if (accepted_count == 0u || !(luminance_weight > 0.0))
	{
		measurement.exposure_white = vec4(0.0, D65_XY, 0.0);
		measurement.target_log_lms = vec4(0.0);
		measurement.solar_diagnostics = vec4(0.0);
		return;
	}

	float base_target_ev = -weighted_ev / float(accepted_count);
	float target_ev = clamp(
		base_target_ev,
		min(pc.auto_exposure_min_ev, pc.auto_exposure_max_ev),
		max(pc.auto_exposure_min_ev, pc.auto_exposure_max_ev));
	vec2 measured_xy = vec2(weighted_x, weighted_y) / luminance_weight;
	float mean_y = luminance_weight / float(accepted_count);
	float safe_y = max(measured_xy.y, 1.0e-6);
	vec3 measured_xyz = vec3(
		measured_xy.x / safe_y * mean_y,
		mean_y,
		max(1.0 - measured_xy.x - measured_xy.y, 0.0) / safe_y * mean_y);
	vec3 virtual_xyz = vec3(
		D65_XY.x / D65_XY.y * VIRTUAL_D65_Y,
		VIRTUAL_D65_Y,
		(1.0 - D65_XY.x - D65_XY.y) / D65_XY.y * VIRTUAL_D65_Y);
	vec3 mixed_xyz = measured_xyz + virtual_xyz;
	float mixed_sum = mixed_xyz.x + mixed_xyz.y + mixed_xyz.z;
	vec2 white_xy = mixed_xyz.xy / max(mixed_sum, 1.0e-6);
	vec3 source_white_xyz = vec3(
		white_xy.x / max(white_xy.y, 1.0e-6),
		1.0,
		max(1.0 - white_xy.x - white_xy.y, 0.0) / max(white_xy.y, 1.0e-6));
	vec3 source_lms = BRADFORD * source_white_xyz;
	vec3 d65_lms = BRADFORD * D65_XYZ;
	vec3 log_lms = clamp(log2(max(d65_lms, vec3(1.0e-6))
		/ max(source_lms, vec3(1.0e-6))), vec3(-1.0), vec3(1.0));
	measurement.exposure_white = vec4(target_ev, white_xy, 1.0);
	measurement.target_log_lms = vec4(log_lms, float(accepted_count));
	measurement.solar_diagnostics = vec4(base_target_ev, target_ev, 0.0, 0.0);
}
