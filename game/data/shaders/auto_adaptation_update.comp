#version 450

#include "auto_adaptation.h"

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 0) readonly buffer MeasurementBuffer
{
	vec4 exposure_white;
	vec4 target_log_lms;
} measurement;

layout(std430, set = 0, binding = 1) buffer AdaptationStateBuffer
{
	vec4 values[AUTO_ADAPTATION_STATE_VEC4_COUNT];
} adaptation;

layout(push_constant) uniform PushConstants
{
	float delta_time;
	int auto_exposure_enabled;
	int auto_white_balance_enabled;
	int reset_mask;
	float auto_exposure_min_ev;
	float auto_exposure_max_ev;
	float auto_exposure_darkening_seconds;
	float auto_exposure_brightening_seconds;
	float auto_white_balance_seconds;
	float auto_white_balance_strength;
} pc;

const mat3 LINEAR_SRGB_TO_XYZ = mat3(
	vec3(0.4124564, 0.2126729, 0.0193339),
	vec3(0.3575761, 0.7151522, 0.1191920),
	vec3(0.1804375, 0.0721750, 0.9503041));
const mat3 XYZ_TO_LINEAR_SRGB = mat3(
	vec3( 3.2404542, -0.9692660,  0.0556434),
	vec3(-1.5371385,  1.8760108, -0.2040259),
	vec3(-0.4985314,  0.0415560,  1.0572252));
const mat3 BRADFORD = mat3(
	vec3( 0.8951, -0.7502,  0.0389),
	vec3( 0.2664,  1.7135, -0.0685),
	vec3(-0.1614,  0.0367,  1.0296));
const mat3 BRADFORD_INVERSE = mat3(
	vec3( 0.9869929,  0.4323053, -0.0085287),
	vec3(-0.1470543,  0.5183603,  0.0400428),
	vec3( 0.1599627,  0.0492912,  0.9684867));

float smooth_value(float current, float target, float tau)
{
	float alpha = 1.0 - exp(-clamp(pc.delta_time, 0.0, 0.1) / max(tau, 1.0e-6));
	return mix(current, target, alpha);
}

void write_white_balance_matrix(vec3 log_lms)
{
	mat3 matrix = XYZ_TO_LINEAR_SRGB * BRADFORD_INVERSE
		* mat3(vec3(exp2(log_lms.x), 0.0, 0.0),
			vec3(0.0, exp2(log_lms.y), 0.0),
			vec3(0.0, 0.0, exp2(log_lms.z)))
		* BRADFORD * LINEAR_SRGB_TO_XYZ;
	adaptation.values[AUTO_ADAPTATION_STATE_WB_COLUMN_0] = vec4(matrix[0], 0.0);
	adaptation.values[AUTO_ADAPTATION_STATE_WB_COLUMN_1] = vec4(matrix[1], 0.0);
	adaptation.values[AUTO_ADAPTATION_STATE_WB_COLUMN_2] = vec4(matrix[2], 0.0);
}

void main()
{
	bool measurement_valid = measurement.exposure_white.w > 0.5;
	vec4 exposure_white = adaptation.values[AUTO_ADAPTATION_STATE_EXPOSURE_WHITE];
	vec3 current_log_lms = adaptation.values[AUTO_ADAPTATION_STATE_CURRENT_LOG_LMS].xyz;
	vec4 status = adaptation.values[AUTO_ADAPTATION_STATE_STATUS];
	if ((pc.reset_mask & 1) != 0) status.y = 0.0;
	if ((pc.reset_mask & 2) != 0) status.z = 0.0;

	if (measurement_valid)
	{
		float target_ev = clamp(
			measurement.exposure_white.x,
			min(pc.auto_exposure_min_ev, pc.auto_exposure_max_ev),
			max(pc.auto_exposure_min_ev, pc.auto_exposure_max_ev));
		vec3 target_log_lms = measurement.target_log_lms.xyz
			* clamp(pc.auto_white_balance_strength, 0.0, 1.0);
		exposure_white.yzw = vec3(
			target_ev,
			measurement.exposure_white.y,
			measurement.exposure_white.z);
		adaptation.values[AUTO_ADAPTATION_STATE_TARGET_LOG_LMS] =
			vec4(target_log_lms, 0.0);
		if (pc.auto_exposure_enabled != 0)
		{
			if (status.y < 0.5)
				exposure_white.x = target_ev;
			else
			{
				float tau = target_ev < exposure_white.x
					? pc.auto_exposure_darkening_seconds
					: pc.auto_exposure_brightening_seconds;
				exposure_white.x = smooth_value(
					exposure_white.x, target_ev, tau);
			}
			status.y = 1.0;
		}
		else
		{
			exposure_white.x = 0.0;
			status.y = 0.0;
		}

		if (pc.auto_white_balance_enabled != 0)
		{
			if (status.z < 0.5)
				current_log_lms = target_log_lms;
			else
			{
				current_log_lms.x = smooth_value(
					current_log_lms.x, target_log_lms.x, pc.auto_white_balance_seconds);
				current_log_lms.y = smooth_value(
					current_log_lms.y, target_log_lms.y, pc.auto_white_balance_seconds);
				current_log_lms.z = smooth_value(
					current_log_lms.z, target_log_lms.z, pc.auto_white_balance_seconds);
			}
			status.z = 1.0;
		}
		else
		{
			current_log_lms = vec3(0.0);
			status.z = 0.0;
		}
	}
	else
	{
		if (pc.auto_exposure_enabled == 0) exposure_white.x = 0.0;
		if (pc.auto_white_balance_enabled == 0) current_log_lms = vec3(0.0);
	}

	adaptation.values[AUTO_ADAPTATION_STATE_EXPOSURE_WHITE] = exposure_white;
	adaptation.values[AUTO_ADAPTATION_STATE_CURRENT_LOG_LMS] = vec4(current_log_lms, 0.0);
	status.x = measurement_valid ? 1.0 : 0.0;
	status.w = measurement.target_log_lms.w;
	adaptation.values[AUTO_ADAPTATION_STATE_STATUS] = status;
	write_white_balance_matrix(current_log_lms);
}
