#version 450

// Clears one clipmap level's slab (albedo/occupancy, normal, both radiance sides).

#include "sdf_gi/sdf_common.h"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba8) uniform writeonly image3D albedo_image;
layout(set = 0, binding = 1, rgba8) uniform writeonly image3D normal_emission_image;
layout(set = 0, binding = 2, rgba16f) uniform writeonly image3D radiance_front_image;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image3D radiance_back_image;

layout(push_constant) uniform PushConstants { ivec4 level; } pc;

void main()
{
	ivec3 texel = ivec3(gl_GlobalInvocationID.xy, gl_GlobalInvocationID.z + pc.level.x * SDF_LEVEL_RES);
	imageStore(albedo_image, texel, vec4(0.0));
	imageStore(normal_emission_image, texel, vec4(0.5, 0.5, 1.0, 0.0));
	imageStore(radiance_front_image, texel, vec4(0.0));
	imageStore(radiance_back_image, texel, vec4(0.0));
}
