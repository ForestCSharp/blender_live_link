#version 450

// SDF GI resolve: per pixel, blends the SH9 of the 4 surrounding screen
// probes (bilinear x normal agreement x plane distance), accumulates the
// irradiance over frames (jittered lookup + reprojected history) and writes
//   irradiance = E(n) / pi  (lighting.frag multiplies by albedo, like the octree)
//   specular   = SH radiance at the reflection direction (blurry stand-in until
//                SDF reflections).
// Debug views replace the irradiance output; lighting.frag shows it as-is.

#define SDF_PARAMS_SET 1
#include "sdf_gi/sdf_common.h"
#include "gi/probe_radiance.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gbuffer_position_tex;
layout(set = 0, binding = 1) uniform sampler2D gbuffer_normal_tex;
layout(set = 0, binding = 2, rgba32f) uniform readonly image2D probe_position_image;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D probe_normal_image;
layout(set = 0, binding = 4, std430) readonly buffer ShBlock { vec4 probe_sh[]; };
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D irradiance_image;
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D specular_image;
layout(set = 0, binding = 7, rgba16f) uniform readonly image2D filtered_image;
layout(set = 0, binding = 8) uniform sampler2D previous_history_tex;	// irradiance, a = view depth when written
layout(set = 0, binding = 9, rgba16f) uniform writeonly image2D history_image;

layout(push_constant) uniform Push
{
	ivec4 flags;	// x = history valid, y = jitter + per-pixel temporal on
} push;

#define DEBUG_NONE 0
#define DEBUG_SDF_NORMALS 1
#define DEBUG_SDF_STEPS 2
#define DEBUG_VOXEL_ALBEDO 3
#define DEBUG_VOXEL_RADIANCE 4
#define DEBUG_PROBE_RADIANCE 5
#define DEBUG_IRRADIANCE_ONLY 6
#define DEBUG_REFLECTIONS 7	// final specular (sdf_reflection_resolve.comp overwrites where it traces)

vec3 debug_camera_ray(ivec2 pixel)
{
	vec2 uv = (vec2(pixel) + 0.5) / vec2(sdf.screen.xy);
	// z = 0.5 stays finite with reverse-Z infinite projections (z = 0 is at infinity).
	vec4 point = sdf.inv_view_projection * vec4(uv.x * 2.0 - 1.0, 1.0 - uv.y * 2.0, 0.5, 1.0);
	return normalize(point.xyz / point.w - sdf.camera_position.xyz);
}

vec3 debug_view(ivec2 pixel, int mode)
{
	if (mode == DEBUG_PROBE_RADIANCE)
	{
		ivec2 probe = pixel / SDF_PROBE_TILE;
		ivec2 oct = (pixel - probe * SDF_PROBE_TILE) * SDF_PROBE_RES / SDF_PROBE_TILE;
		return imageLoad(filtered_image, probe * SDF_PROBE_RES + oct).rgb;
	}
	vec3 dir = debug_camera_ray(pixel);
	SdfHit hit;
	bool found = sdf_trace(sdf.camera_position.xyz, dir, 1.0e4, hit);
	if (mode == DEBUG_SDF_STEPS)
	{
		float t = float(hit.steps) / 64.0;
		return vec3(t, 1.0 - abs(t * 2.0 - 1.0), 1.0 - t) * (found ? 1.0 : 0.3);
	}
	if (!found) return mode == DEBUG_VOXEL_RADIANCE ? sdf_sample_sky(dir) : vec3(0.0);
	if (mode == DEBUG_SDF_NORMALS) return sdf_gradient(hit.level, hit.position) * 0.5 + 0.5;
	if (mode == DEBUG_VOXEL_ALBEDO) return sdf_sample_hit_albedo(hit.level, hit.position);
	return sdf_sample_hit_radiance(hit.level, hit.position, dir).rgb;
}

// SH9 of the 4 probes around probe-grid point f (bilinear x normal agreement x
// plane distance), normalised. False when no probe is compatible.
bool gather_sh(ivec2 pixel, vec2 f, vec3 position, vec3 normal, float tolerance, out vec3 sh[9])
{
	ivec2 base = ivec2(floor(f));
	vec2 frac_part = f - vec2(base);
	for (int i = 0; i < 9; ++i) sh[i] = vec3(0.0);
	float weight_sum = 0.0;
	for (int c = 0; c < 4; ++c)
	{
		ivec2 corner = ivec2(c & 1, c >> 1);
		ivec2 probe = clamp(base + corner, ivec2(0), sdf.screen.zw - 1);
		vec4 probe_position = imageLoad(probe_position_image, probe);
		if (probe_position.w < 0.5) continue;
		vec3 probe_normal = imageLoad(probe_normal_image, probe).xyz;
		vec2 bilinear = mix(1.0 - frac_part, frac_part, vec2(corner));
		float plane_distance = abs(dot(probe_position.xyz - position, normal));
		float w = bilinear.x * bilinear.y
			* pow(max(dot(probe_normal, normal), 0.0), 4.0)
			* exp(-plane_distance / tolerance);
		if (w <= 1e-5) continue;
		uint probe_index = uint(probe.y * sdf.screen.z + probe.x);
		for (int i = 0; i < 9; ++i) sh[i] += probe_sh[probe_index * 9u + uint(i)].rgb * w;
		weight_sum += w;
	}
	if (weight_sum <= 1e-5)
	{
		// No compatible neighbour: fall back to this pixel's own tile probe.
		ivec2 probe = min(pixel / SDF_PROBE_TILE, sdf.screen.zw - 1);
		if (imageLoad(probe_position_image, probe).w < 0.5) return false;
		uint probe_index = uint(probe.y * sdf.screen.z + probe.x);
		for (int i = 0; i < 9; ++i) sh[i] = probe_sh[probe_index * 9u + uint(i)].rgb;
		return true;
	}
	for (int i = 0; i < 9; ++i) sh[i] /= weight_sum;
	return true;
}

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, sdf.screen.xy))) return;
	const int mode = sdf.debug.x;
	if (mode != DEBUG_NONE && mode != DEBUG_IRRADIANCE_ONLY && mode != DEBUG_REFLECTIONS)
	{
		imageStore(irradiance_image, pixel, vec4(debug_view(pixel, mode), 1.0));
		imageStore(specular_image, pixel, vec4(0.0));
		imageStore(history_image, pixel, vec4(0.0));
		return;
	}

	vec4 position = texelFetch(gbuffer_position_tex, pixel, 0);
	if (position.w < 0.5)
	{
		imageStore(irradiance_image, pixel, vec4(0.0));
		imageStore(specular_image, pixel, vec4(0.0));
		imageStore(history_image, pixel, vec4(0.0));
		return;
	}
	vec3 normal = normalize(texelFetch(gbuffer_normal_tex, pixel, 0).xyz);
	float tolerance = 0.02 * length(position.xyz - sdf.camera_position.xyz) + 0.1;

	// The probes are looked up from a point jittered by up to half a tile each frame,
	// so a probe's error spreads over more pixels and the history below averages it
	// out instead of leaving a fixed 16 px blotch. The SH specular (rough surfaces
	// only; SDF reflections replace it below the cutoff) is left to TAA.
	bool accumulate = push.flags.y != 0;
	vec2 jitter = accumulate
		? vec2(sdf_hash(uvec3(uvec2(pixel), uint(sdf.counts.z))), sdf_hash(uvec3(uvec2(pixel.yx), uint(sdf.counts.z) + 17u))) - 0.5
		: vec2(0.0);
	vec3 sh[9];
	vec3 irradiance = vec3(0.0);
	vec3 specular = vec3(0.0);
	if (gather_sh(pixel, (vec2(pixel) + 0.5) / float(SDF_PROBE_TILE) - 0.5 + jitter, position.xyz, normal, tolerance, sh))
	{
		vec3 view = normalize(sdf.camera_position.xyz - position.xyz);
		vec3 reflection = reflect(-view, normal);
		for (int i = 0; i < 9; ++i)
		{
			irradiance += sh[i] * (sh9_diffuse_convolution_factor(i) * sh9_basis(i, normal));
			specular += sh[i] * sh9_basis(i, reflection);
		}
		irradiance = max(irradiance, vec3(0.0)) / M_PI;
		specular = max(specular, vec3(0.0));
	}

	// Per-pixel temporal, reprojected with the surface (same scheme as sdf_reflection_resolve.comp).
	float view_depth = (sdf.view_projection * position).w;
	vec4 previous_clip = sdf.prev_view_projection * vec4(position.xyz, 1.0);
	if (accumulate && push.flags.x != 0 && previous_clip.w > 1e-4)
	{
		vec2 ndc = previous_clip.xy / previous_clip.w;
		vec2 previous_uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);	// temporal_aa.frag convention
		if (all(greaterThanEqual(previous_uv, vec2(0.0))) && all(lessThan(previous_uv, vec2(1.0))))
		{
			vec4 history = textureLod(previous_history_tex, previous_uv, 0.0);
			if (history.a > 0.0 && abs(history.a - previous_clip.w) < 0.02 * previous_clip.w + 0.05)
			{
				// shortcut: no neighbourhood clamp (the jitter makes the neighbourhood noisy on purpose);
				// lighting changes rely on the fast-response hysteresis. Add a clamp if moving objects ghost.
				irradiance = mix(irradiance, history.rgb, sdf.settings.y);
			}
		}
	}
	imageStore(history_image, pixel, vec4(irradiance, view_depth));
	imageStore(irradiance_image, pixel, vec4(mode == DEBUG_REFLECTIONS ? specular : irradiance, 1.0));
	imageStore(specular_image, pixel, vec4(specular, 1.0));
}
