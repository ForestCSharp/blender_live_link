#version 450

// SDF GI screen probes, spatial filter: averages each texel with the same
// direction of up to 8 neighbouring probes on the same surface.

#define SDF_PARAMS_SET 1
#include "sdf_gi/sdf_common.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba32f) uniform readonly image2D probe_position_image;
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D probe_normal_image;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D history_image;
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D filtered_image;

void main()
{
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(texel, sdf.screen.zw * SDF_PROBE_RES))) return;
	ivec2 probe = texel / SDF_PROBE_RES;
	ivec2 oct = texel - probe * SDF_PROBE_RES;
	vec4 center = imageLoad(history_image, texel);
	vec4 position = imageLoad(probe_position_image, probe);
	if (position.w < 0.5 || center.a <= 0.0 || sdf.debug.z == 0)
	{
		imageStore(filtered_image, texel, center);
		return;
	}
	vec3 normal = imageLoad(probe_normal_image, probe).xyz;
	float tolerance = 0.02 * length(position.xyz - sdf.camera_position.xyz) + 0.1;
	vec3 sum = center.rgb;
	float weight_sum = 1.0;
	for (int y = -1; y <= 1; ++y)
	for (int x = -1; x <= 1; ++x)
	{
		ivec2 neighbor = probe + ivec2(x, y);
		if ((x == 0 && y == 0) || any(lessThan(neighbor, ivec2(0))) || any(greaterThanEqual(neighbor, sdf.screen.zw))) continue;
		vec4 neighbor_position = imageLoad(probe_position_image, neighbor);
		if (neighbor_position.w < 0.5) continue;
		vec3 neighbor_normal = imageLoad(probe_normal_image, neighbor).xyz;
		if (dot(neighbor_normal, normal) < 0.7 || abs(dot(neighbor_position.xyz - position.xyz, normal)) > tolerance) continue;
		vec4 value = imageLoad(history_image, neighbor * SDF_PROBE_RES + oct);
		if (value.a <= 0.0) continue;
		sum += value.rgb * 0.5;
		weight_sum += 0.5;
	}
	imageStore(filtered_image, texel, vec4(sum / weight_sum, 1.0));
}
