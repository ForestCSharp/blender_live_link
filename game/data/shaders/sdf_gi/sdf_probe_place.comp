#version 450

// SDF GI screen probes, placement: one probe per 16x16 tile, on a G-buffer
// surface at a pixel jittered per frame (sky pixels are skipped).

#define SDF_PARAMS_SET 1
#include "sdf_gi/sdf_common.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gbuffer_position_tex;
layout(set = 0, binding = 1) uniform sampler2D gbuffer_normal_tex;
layout(set = 0, binding = 2, rgba32f) uniform writeonly image2D probe_position_image;	// w = 1 valid
layout(set = 0, binding = 3, rgba16f) uniform writeonly image2D probe_normal_image;

void main()
{
	ivec2 probe = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(probe, sdf.screen.zw))) return;
	ivec2 tile_origin = probe * SDF_PROBE_TILE;
	vec4 position = vec4(0.0);
	vec3 normal = vec3(0.0, 0.0, 1.0);
	for (uint attempt = 0u; attempt < 8u; ++attempt)
	{
		uvec3 seed = uvec3(uvec2(probe), uint(sdf.counts.z) * 8u + attempt);
		ivec2 offset = ivec2(vec2(sdf_hash(seed), sdf_hash(seed.yxz + 7u)) * float(SDF_PROBE_TILE));
		ivec2 pixel = min(tile_origin + offset, sdf.screen.xy - 1);
		vec4 candidate = texelFetch(gbuffer_position_tex, pixel, 0);
		if (candidate.w > 0.5)
		{
			position = vec4(candidate.xyz, 1.0);
			normal = normalize(texelFetch(gbuffer_normal_tex, pixel, 0).xyz);
			break;
		}
	}
	imageStore(probe_position_image, probe, position);
	imageStore(probe_normal_image, probe, vec4(normal, 0.0));
}
