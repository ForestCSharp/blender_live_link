#version 450

// SDF reflections, resolve (full resolution): joint-bilateral upsample of the
// half-res trace (3x3 half-res texels, weighted by plane distance, normal and
// pixel distance), temporal accumulation reprojected with the surface's motion
// (history clamped to the neighbourhood), then a fade to the probe-SH
// stand-in near the roughness cutoff. Writes the result over the specular
// image that sdf_gi_resolve.comp filled.

#define SDF_PARAMS_SET 1
#include "sdf_gi/sdf_common.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gbuffer_position_tex;
layout(set = 0, binding = 1) uniform sampler2D gbuffer_normal_tex;
layout(set = 0, binding = 2) uniform sampler2D gbuffer_rme_tex;
layout(set = 0, binding = 3, rgba16f) uniform readonly image2D trace_image;
layout(set = 0, binding = 4) uniform sampler2D previous_history_tex;	// a = view depth when written
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D history_image;
layout(set = 0, binding = 6, rgba16f) uniform image2D specular_image;
layout(set = 0, binding = 7, rgba16f) uniform writeonly image2D irradiance_image;	// debug view output

layout(push_constant) uniform Push
{
	ivec4 offset;	// xy = traced pixel within each 2x2 block this frame, z = history valid
} push;

#define DEBUG_REFLECTIONS 7

void main()
{
	ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(pixel, sdf.screen.xy))) return;
	vec4 position = texelFetch(gbuffer_position_tex, pixel, 0);
	float roughness = texelFetch(gbuffer_rme_tex, pixel, 0).r;
	if (position.w < 0.5 || roughness >= SDF_REFLECTION_MAX_ROUGHNESS)
	{
		imageStore(history_image, pixel, vec4(0.0));
		return;
	}
	vec3 normal = normalize(texelFetch(gbuffer_normal_tex, pixel, 0).xyz);
	vec3 probe_specular = imageLoad(specular_image, pixel).rgb;
	float tolerance = 0.02 * length(position.xyz - sdf.camera_position.xyz) + 0.05;

	ivec2 half_size = imageSize(trace_image);
	ivec2 center = pixel / 2;
	vec3 sum = vec3(0.0);
	float weight_sum = 0.0;
	vec3 lo = vec3(1e30);
	vec3 hi = vec3(-1e30);
	for (int dy = -1; dy <= 1; ++dy)
	{
		for (int dx = -1; dx <= 1; ++dx)
		{
			ivec2 half_pixel = clamp(center + ivec2(dx, dy), ivec2(0), half_size - 1);
			vec4 s = imageLoad(trace_image, half_pixel);
			if (s.a <= 0.0) continue;
			ivec2 source = min(half_pixel * 2 + push.offset.xy, sdf.screen.xy - 1);
			vec3 source_position = texelFetch(gbuffer_position_tex, source, 0).xyz;
			vec3 source_normal = texelFetch(gbuffer_normal_tex, source, 0).xyz;
			float plane_distance = abs(dot(source_position - position.xyz, normal));
			vec2 d = vec2(source - pixel);
			float w = exp(-plane_distance / tolerance)
				* pow(max(dot(source_normal, normal), 0.0), 8.0)
				* exp(-dot(d, d) / 8.0);
			if (w <= 1e-4) continue;
			sum += s.rgb * w;
			weight_sum += w;
			lo = min(lo, s.rgb);
			hi = max(hi, s.rgb);
		}
	}
	vec3 current = weight_sum > 1e-4 ? sum / weight_sum : probe_specular;
	if (weight_sum <= 1e-4) { lo = current; hi = current; }

	float view_depth = (sdf.view_projection * position).w;
	vec3 result = current;
	vec4 previous_clip = sdf.prev_view_projection * vec4(position.xyz, 1.0);
	if (push.offset.z != 0 && previous_clip.w > 1e-4)
	{
		vec2 ndc = previous_clip.xy / previous_clip.w;
		vec2 previous_uv = vec2(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5);	// temporal_aa.frag convention
		if (all(greaterThanEqual(previous_uv, vec2(0.0))) && all(lessThan(previous_uv, vec2(1.0))))
		{
			vec4 history = textureLod(previous_history_tex, previous_uv, 0.0);
			if (history.a > 0.0 && abs(history.a - previous_clip.w) < 0.02 * previous_clip.w + 0.05)
			{
				// shortcut: reprojects with the surface, not the reflected point, so mirror
				// reflections smear a little while the camera moves; upgrade with hit-depth reprojection.
				vec3 spread = 0.25 * (hi - lo) + 0.01;
				vec3 clamped = clamp(history.rgb, lo - spread, hi + spread);
				float hysteresis = mix(0.75, 0.92, roughness / SDF_REFLECTION_MAX_ROUGHNESS);
				result = mix(current, clamped, hysteresis);
			}
		}
	}
	imageStore(history_image, pixel, vec4(result, view_depth));

	float fade_to_probe = smoothstep(0.7 * SDF_REFLECTION_MAX_ROUGHNESS, SDF_REFLECTION_MAX_ROUGHNESS, roughness);
	vec3 specular = mix(result, probe_specular, fade_to_probe);
	imageStore(specular_image, pixel, vec4(specular, 1.0));
	if (sdf.debug.x == DEBUG_REFLECTIONS) imageStore(irradiance_image, pixel, vec4(specular, 1.0));
}
