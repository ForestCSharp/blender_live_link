#version 450

// SDF reflections, trace: one GGX-sampled ray per 2x2 pixel block (half
// resolution; which pixel of the block rotates per frame, push.offset). Tracers
// in order, as in Lumen:
//   1. screen: a short march against the G-buffer; the hit's colour is last
//      frame's TAA output there (lit, sub-voxel detail, includes dynamic objects)
//   2. SDF: the voxel radiance cache (anything off-screen or occluded)
//   3. sky
// a = 1 where traced, 0 for sky pixels and surfaces rougher than the cutoff.

#define SDF_PARAMS_SET 1
#include "sdf_gi/sdf_common.h"
#include "shared/sampling.h"
#include "sdf_gi/sdf_screen_trace.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D gbuffer_position_tex;
layout(set = 0, binding = 1) uniform sampler2D gbuffer_normal_tex;
layout(set = 0, binding = 2) uniform sampler2D gbuffer_rme_tex;
layout(set = 0, binding = 3) uniform sampler2D previous_color_tex;	// last frame's TAA history (pre-tonemap)
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D trace_image;

layout(push_constant) uniform Push
{
	ivec4 offset;	// xy = traced pixel within each 2x2 block, z = screen trace on (TAA history valid)
} push;

#define SCREEN_STEPS 24
#define SCREEN_MAX_DISTANCE 8.0

// t_clear: distance the screen trace already cleared; the SDF continues from there.
vec3 world_trace(vec3 position, vec3 normal, vec3 dir, float t_clear)
{
	int level = max(sdf_finest_level(position), 0);
	// Same start offset as the screen probes: the SDF can't resolve the surface itself.
	vec3 origin = position + normal * (1.5 * sdf_voxel_size(level)) + dir * t_clear;
	SdfHit hit;
	if (sdf_trace(origin, dir, 1.0e4, hit)) return sdf_sample_hit_radiance(hit.level, hit.position, dir).rgb;
	return sdf_sample_sky(dir);
}

void main()
{
	ivec2 half_pixel = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(half_pixel, imageSize(trace_image)))) return;
	ivec2 pixel = min(half_pixel * 2 + push.offset.xy, sdf.screen.xy - 1);
	vec4 position = texelFetch(gbuffer_position_tex, pixel, 0);
	float roughness = texelFetch(gbuffer_rme_tex, pixel, 0).r;
	if (position.w < 0.5 || roughness >= SDF_REFLECTION_MAX_ROUGHNESS)
	{
		imageStore(trace_image, half_pixel, vec4(0.0));
		return;
	}
	vec3 normal = normalize(texelFetch(gbuffer_normal_tex, pixel, 0).xyz);
	vec3 view = normalize(sdf.camera_position.xyz - position.xyz);
	uvec3 seed = uvec3(uvec2(half_pixel), uint(sdf.counts.z));
	vec2 xi = vec2(sdf_hash(seed), sdf_hash(seed.yxz + 7u));
	vec3 dir = reflect(-view, sampling_importance_sample_ggx(xi, normal, roughness));
	if (dot(dir, normal) <= 0.0) dir = reflect(-view, normal);

	vec3 screen_radiance = vec3(0.0);
	float confidence = 0.0;
	float t_clear = 0.0;
	if (push.offset.z != 0)
	{
		vec3 origin = position.xyz + normal * (0.002 * length(sdf.camera_position.xyz - position.xyz) + 0.01);
		confidence = sdf_screen_trace(gbuffer_position_tex, gbuffer_normal_tex, previous_color_tex,
			origin, dir, SCREEN_MAX_DISTANCE, SCREEN_STEPS, sdf_hash(seed.zxy + 13u), screen_radiance, t_clear);
	}
	vec3 radiance = screen_radiance;
	if (confidence < 1.0)
	{
		radiance = mix(world_trace(position.xyz, normal, dir, t_clear), screen_radiance, confidence);
	}
	imageStore(trace_image, half_pixel, vec4(radiance, 1.0));
}
