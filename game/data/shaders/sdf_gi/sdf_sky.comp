#version 450

// SDF GI sky: octahedral sky radiance at the camera (rays that miss the SDF
// sample this) plus the sun's irradiance there, after atmospheric
// transmittance. Matches probe_sky_relight.frag / lighting.frag's sun.

#include "sky/bruneton_parameters.h"
#include "sdf_gi/sdf_common.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 1) uniform sampler2D transmittance_texture;
layout(set = 0, binding = 2) uniform sampler2DArray scattering_texture;
layout(set = 0, binding = 3) uniform sampler2DArray unused_single_mie_texture;

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D sky_image;
layout(set = 1, binding = 1, std430) writeonly buffer SunBlock { vec4 sun_irradiance; };

layout(push_constant) uniform PushConstants
{
	vec4 camera_position;
	vec4 sun_direction;				// xyz = toward the sun, w = 1 when a sun exists
	vec4 sky_color_and_intensity;	// rgb = sun color energy, w = sky intensity (0 = no sky)
	vec4 sun_irradiance_and_atmosphere;	// rgb = top-of-atmosphere scene irradiance, w = planet centre z
	ivec4 flags;					// x = atmosphere enabled
} pc;

void main()
{
	ivec2 texel = ivec2(gl_GlobalInvocationID.xy);
	vec3 dir = octahedral_decode((vec2(texel) + 0.5) / float(SDF_SKY_RES) * 2.0 - 1.0);
	vec3 sky = vec3(0.0);
	if (pc.flags.x != 0 && pc.sky_color_and_intensity.w > 0.0)
	{
		AtmosphereParameters atmosphere = GetAtmosphere();
		vec3 camera = GetAtmosphereCameraPosition(
			atmosphere, pc.camera_position.xyz, pc.sun_irradiance_and_atmosphere.w);
		vec3 transmittance;
		vec3 luminance = GetSkyLuminance(atmosphere, transmittance_texture, scattering_texture,
			unused_single_mie_texture, camera, dir, normalize(pc.sun_direction.xyz), transmittance);
		sky = max(luminance, vec3(0.0)) * BRUNETON_SCENE_PHOTOMETRIC_SCALE
			* pc.sky_color_and_intensity.rgb * pc.sky_color_and_intensity.w;
	}
	imageStore(sky_image, texel, vec4(SanitizeSceneColor(sky), 1.0));

	if (texel == ivec2(0))
	{
		vec3 irradiance = pc.sun_direction.w > 0.0 ? pc.sun_irradiance_and_atmosphere.rgb : vec3(0.0);
		if (pc.flags.x != 0 && pc.sun_direction.w > 0.0)
		{
			AtmosphereParameters atmosphere = GetAtmosphere();
			vec3 camera = GetAtmosphereCameraPosition(
				atmosphere, pc.camera_position.xyz, pc.sun_irradiance_and_atmosphere.w);
			irradiance *= GetAtmosphereSunTransmittance(
				atmosphere, transmittance_texture, camera, normalize(pc.sun_direction.xyz));
		}
		sun_irradiance = vec4(SanitizeSceneColor(irradiance), 1.0);
	}
}
