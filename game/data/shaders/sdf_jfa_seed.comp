#version 450

// Jump flood, seed: every occupied voxel is its own nearest surface.

#include "sdf_common.h"

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;

layout(set = 0, binding = 0, rgba8) uniform readonly image3D albedo_image;
layout(set = 0, binding = 1, r32ui) uniform writeonly uimage3D seeds_out;

layout(push_constant) uniform PushConstants { ivec4 level; } pc;

void main()
{
	ivec3 voxel = ivec3(gl_GlobalInvocationID);
	float occupancy = imageLoad(albedo_image, ivec3(voxel.xy, voxel.z + pc.level.x * SDF_LEVEL_RES)).a;
	imageStore(seeds_out, voxel, uvec4(occupancy > 0.0 ? sdf_jfa_pack(voxel) : SDF_JFA_INVALID));
}
