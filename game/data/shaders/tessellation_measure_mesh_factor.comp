#version 450

#include "tessellation_common.h"

layout(push_constant) uniform plan_params {
	mat4 model_matrix;
	vec4 camera_position;
	int source_triangle_count;
	int base_triangle_index;
	int max_patch_count;
	int max_vertex_count;
	int max_index_count;
	int max_factor;
	int virtual_patches_enabled;
	int virtual_patch_max_depth;
	int tessellation_mode;
	int fixed_factor;
	int material_index;
	int displacement_enabled;
	float fov_radians;
	float render_height;
	float target_pixels_per_segment;
	float displacement_detail_strength;
};

layout(set=0, binding=0, std430) readonly buffer MeasureSourceVerticesBuffer {
	TessellationVertex measure_source_vertices[];
};

layout(set=0, binding=1, std430) readonly buffer MeasureSourceIndicesBuffer {
	TessellationIndex measure_source_indices[];
};

layout(set=0, binding=2, std430) buffer MeasureCountersBuffer {
	TessellationCounters measure_counters[];
};

layout(local_size_x=64, local_size_y=1, local_size_z=1) in;

/**
 * measure_mesh_factor scans source triangles and records the highest adaptive factor needed by this mesh.
 * The planner later uses this value for adaptive per-mesh tessellation.
 */
void main()
{
	uint source_triangle_index = uint(base_triangle_index) + gl_WorkGroupID.x;
	if (source_triangle_index >= uint(max(source_triangle_count, 0)) || gl_LocalInvocationID.x != 0u)
	{
		return;
	}

	uint source_index_offset = source_triangle_index * 3u;
	uint i0 = measure_source_indices[source_index_offset + 0u].value;
	uint i1 = measure_source_indices[source_index_offset + 1u].value;
	uint i2 = measure_source_indices[source_index_offset + 2u].value;
	vec3 p0 = tess_world_position(model_matrix, measure_source_vertices[i0].position.xyz);
	vec3 p1 = tess_world_position(model_matrix, measure_source_vertices[i1].position.xyz);
	vec3 p2 = tess_world_position(model_matrix, measure_source_vertices[i2].position.xyz);
	uint max_factor_u = uint(clamp(max_factor, 1, 31));
	vec3 projection_parameters = vec3(
		fov_radians, render_height, target_pixels_per_segment);
	float max_lod = max(
		tess_raw_lod_for_edge(
			p0, p1, camera_position.xyz, projection_parameters),
		max(
			tess_raw_lod_for_edge(
				p1, p2, camera_position.xyz, projection_parameters),
			tess_raw_lod_for_edge(
				p2, p0, camera_position.xyz, projection_parameters)));

	// Per-mesh mode picks one factor for the whole mesh, so displacement relief
	// has to be folded in here as well - otherwise this mode would displace
	// geometry without ever allocating the vertices needed to resolve it.
	if (displacement_enabled != 0 && material_index >= 0
		&& displacement_detail_strength > 0.0)
	{
		Material material = material_data_array[material_index];
		float relief = tess_displacement_relief(
			material,
			measure_source_vertices[i0].texcoord,
			measure_source_vertices[i1].texcoord,
			measure_source_vertices[i2].texcoord);
		if (relief > 0.0)
		{
			float mid_distance = length(
				(p0 + p1 + p2) / 3.0 - camera_position.xyz);
			max_lod = max(max_lod, tess_raw_lod_for_edge_at_distance(
				relief * displacement_detail_strength,
				mid_distance,
				projection_parameters));
		}
	}

	uint factor = clamp(uint(ceil(max_lod)), 1u, max_factor_u);
	atomicMax(measure_counters[0].max_factor_seen, factor);
}
